# Copy this file to `.env` (already gitignored) and fill in real values
# before running `docker compose up`. Never commit the real `.env`.

# SQL Server "sa" password. Must satisfy SQL Server's complexity policy:
# 8+ chars, upper+lower+digit+symbol.
SQL_SA_PASSWORD=Change-Me-123!

# JWT signing key, 32+ bytes. Generate one with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-real-32-byte-minimum-secret

# The origin the frontend is actually served from, e.g. https://vet.example.com
# Must match exactly (scheme + host + port) or the browser will get CORS errors.
FRONTEND_ORIGIN=http://localhost:8080

# Password reset email settings. RESET_URL_BASE should point at the Angular
# reset screen. Fill SMTP values before relying on self-service password reset
# in a real pilot.
PASSWORD_RESET_URL_BASE=http://localhost:8080/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VetPlatform
SMTP_USERNAME=
SMTP_PASSWORD=

# Password for the two bootstrap accounts seeded on first startup
# (superadmin@vetplatform.dev, admin@vetplatform.dev). Change this from the
# default, log in once, then follow docs/DEPLOYMENT.md to create the real
# clinic/admin and retire these. 8+ chars, upper+lower+digit.
DEMO_ADMIN_PASSWORD=Change-Me-Too-123
